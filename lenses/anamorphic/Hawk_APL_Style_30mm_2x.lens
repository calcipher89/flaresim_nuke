# Hawk APL style 30mm 2x
#
# Front anamorphic made by lenses/make_anamorphic.py from
#   lens_files/AI_Nikkor_35mm_F1.4S.lens (scaled to 30mm)
# scaled to 30mm, with the iris set to f/2.8 (the stop of the reference footage).
# A Galilean cylindrical attachment (BK7 glass, coating 1) in front of the
# original lens.  Horizontal field 2x wider (squeeze 2x paraxial), vertical
# unchanged; focal_length below is the vertical (taking lens) focal length.
# The attachment's apertures are 1.5x make_anamorphic.py's default so
# off-axis ghosts are not clipped.
# NOT a Vantage Hawk prescription (none is public).  A stand-in for flare
# work, tuned against Hawk APL test footage: long cool-blue streak and a soft
# glow.
# See looks/Hawk_APL_Style_30mm_2x.json for the matching look.

name: Hawk APL style 30mm 2x
focal_length: 30

surfaces:
# radius     thickness   ior      abbe   semi_ap   coating  type
# --- Front anamorphic attachment: 2x squeeze, cylinder axes vertical ---
  -44.445  3.000  1.51680  64.2  42.9600  1  cyl_y   # plano-concave cylinder, F = -86
  0  77.410  1.00000  0.0  42.9600  1   # flat back, air gap (solved: afocal)
  0  10.030  1.51680  64.2  53.7000  1   # flat front of the positive cylinder
  -88.890  15.000  1.00000  0.0  53.7000  1  cyl_y   # plano-convex cylinder, F = +172
# --- Taking lens ---
# radius       thickness    ior      abbe     semi_ap   coating
  38.9165  1.7500  1.56883  56.00  36.4283  1
  21.3333  3.6666  1.00000  0.00  30.6168  0
  41.6662  1.7500  1.54814  45.90  33.1540  1
  22.0001  7.3332  1.00000  0.00  28.1827  0
  32.3329  7.0833  1.80411  46.40  29.4769  1
  -34.9994  13.3331  1.50137  56.50  29.4769  1
  129.6083  1.1517  1.00000  0.00  25.0112  0
  stop  5.5149  1.00000  0.00  5.4339  0
  -22.2581  3.6666  1.80411  46.40  23.0912  1
  -15.8330  0.8334  1.78470  26.10  23.7513  1
  154.5158  1.4166  1.00000  0.00  25.7141  0
  -94.3989  3.3333  1.77250  49.50  25.7141  1
  -26.2497  0.0417  1.00000  0.00  27.1369  0
  -833.3259  3.1668  1.77250  49.50  27.6941  1
  -45.3751  0.0417  1.00000  0.00  27.6941  0
  87.4998  2.8331  1.71300  53.90  29.2711  1
  -91.2283  31.9317  1.00000  0.00  29.2711  0
